{
  "name": "open-mushroom",
  "version": "0.0.0",
  "description": "Mushroom Gennadiyovych, a living SVG mascot for React: seven emotions, MorphSVG transitions, idle life and a speech bubble.",
  "keywords": [
    "react",
    "mascot",
    "svg",
    "animation",
    "gsap",
    "morphsvg",
    "character",
    "emotions"
  ],
  "homepage": "https://github.com/wallwhite/open-mushroom#readme",
  "bugs": "https://github.com/wallwhite/open-mushroom/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallwhite/open-mushroom.git",
    "directory": "packages/open-mushroom"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/mushroom.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-dts --no-clean",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css && size-limit",
    "mushroom:build": "tsx tools/skeleton/build-mushroom-skeleton.ts",
    "mushroom:check": "pnpm mushroom:build && git diff --exit-code -- src/core/generated",
    "prepack": "pnpm build && cp ../../LICENSE ./",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "gsap": "3.15.0",
    "jsdom": "^27.0.0",
    "paper": "0.12.18",
    "paper-jsdom": "0.12.18",
    "publint": "^0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "size-limit": "^12.1.0",
    "tsdown": "~0.21.10",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "gsap": "^3.13",
    "react": "^19",
    "react-dom": "^19"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
